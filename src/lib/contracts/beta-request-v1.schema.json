{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)\\P{Cc}*$"
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "studio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)\\P{Cc}*$"
    },
    "teamSize": {
      "type": "string",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "200+"
      ]
    },
    "tools": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dropbox",
          "google-drive",
          "wetransfer",
          "aspera",
          "masv",
          "ftp",
          "drives"
        ]
      },
      "uniqueItems": true
    },
    "deliverySize": {
      "type": "string",
      "enum": [
        "lt-10gb",
        "10-100gb",
        "100gb-1tb",
        "gt-1tb"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^(?:\\P{Cc}|[\\t\\n\\r])*$"
    },
    "consent": {
      "type": "boolean",
      "const": true
    },
    "consentVersion": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "website": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "name",
    "email",
    "studio",
    "teamSize",
    "tools",
    "deliverySize",
    "message",
    "consent",
    "consentVersion",
    "website"
  ],
  "additionalProperties": false,
  "$id": "https://api.mirall.app/v1/beta-request/schema.json",
  "title": "Mirall beta request v1",
  "description": "The body of POST <apiUrl>/v1/beta-request, sent as application/json. Patterns are normative and Unicode-aware; `format` is an annotation only. A non-empty `website` (the honeypot) is accepted and dropped."
}
